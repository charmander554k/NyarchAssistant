   "source": [
    "from cryptography.fernet import Fernet\n",
    "\n",
    "clave = Fernet.generate_key()\n",
    "f = Fernet(clave)\n",
    "token = f.encrypt(b'mensaje secreto')\n",
    "print(f.decrypt(token))"
