   "source": [
    "# Análisis de tráfico de red\n",
    "Captura de paquetes con scapy para detectar escaneos."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from scapy.all import sniff, TCP\n",
    "\n",
    "paquetes = sniff(count=50, filter='tcp')\n",
    "syn = [p for p in paquetes if p[TCP].flags == 'S']\n",
    "print(len(syn), 'paquetes SYN')"
   ],
   "outputs": [],
   "execution_count": null
  }
